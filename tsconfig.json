{
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": [
    "config.ts",
    "api/**/*.ts",
    "db/**/*.ts",
    "orchestrator/**/*.ts",
    "sandbox/**/*.ts",
    "sandbox-provider/**/*.ts",
    "tests/**/*.ts"
  ]
}
